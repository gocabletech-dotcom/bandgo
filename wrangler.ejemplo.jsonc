// Copia de ejemplo. El script de publicar crea wrangler.jsonc con el id real de la base (no se sube a GitHub).
{
  "name": "bandgo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bandgo-db", "database_id": "local-bandgo", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARCHIVOS", "bucket_name": "bandgo-archivos" }],
  "triggers": { "crons": ["7 * * * *"] },
  "vars": { "BANDGO_VERSION": "local" }
}
